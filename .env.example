# ============================================================
# SANGAT Tools  —  Environment variables (EXAMPLE)
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in real values (.env is in .gitignore — never committed)
# 3. Generate a strong SECRET_KEY:
#       python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ── Required ──────────────────────────────────────────────────────
# A long, random, secret string.  Rotate this if compromised.
SECRET_KEY=paste-a-very-long-random-string-here-at-least-32-chars

# ── Deployment environment ────────────────────────────────────────
# Set to "production" on live server; keep "development" locally.
FLASK_ENV=development

# Enable Flask debugger only in local development (never in production!)
FLASK_DEBUG=true

# ── Server binding ────────────────────────────────────────────────
PORT=5000

# ── Site URL (no trailing slash) ──────────────────────────────────
# Used for sitemap.xml, robots.txt, canonical URLs, and OG tags.
# Replace with your actual domain when deploying.
SITE_URL=https://sangatsafesite.com

# ── Analytics ─────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (leave blank to disable GA).
# Format: G-XXXXXXXXXX
GA_MEASUREMENT_ID=

# ── File upload limits ────────────────────────────────────────────
MAX_UPLOAD_MB=100

# ── Gunicorn (production only) ───────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Storage paths (optional overrides for cloud deployments) ──────
# UPLOAD_FOLDER=/tmp/uploads
# OUTPUT_FOLDER=/tmp/outputs
# DB_PATH=/tmp/users.db
